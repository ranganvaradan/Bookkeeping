# ============================================================
# BillionTech Bookkeeping Platform — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database (PostgreSQL 15) ---
# Local dev uses localhost:5433 (host-mapped port).
# Inside Docker, the backend connects via container name bt-postgres:5432.
# docker-compose.yml hardcodes the Docker URL; this value is for local dev only.
DB_URL=jdbc:postgresql://localhost:5433/billiontech
DB_USERNAME=bt_user
DB_PASSWORD=your-db-password

# --- Authentication ---
JWT_SECRET=your-32-character-minimum-secret-key

# --- Cache / Queue (Redis 7) ---
# Local dev uses localhost:6380 (host-mapped port).
# Inside Docker, the backend connects via container name bt-redis:6379.
# docker-compose.yml hardcodes the Docker URL; this value is for local dev only.
REDIS_URL=redis://localhost:6380

# --- Frontend ---
FRONTEND_URL=http://localhost:3010
VITE_API_BASE_URL=http://localhost:8085

# --- QuickBooks Online API ---
QBO_CLIENT_ID=from-intuit-developer-portal
QBO_CLIENT_SECRET=from-intuit-developer-portal
QBO_REDIRECT_URI=http://localhost:8085/api/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_ENCRYPTION_KEY=32-char-key-for-aes256-encryption

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=from-console.anthropic.com

# --- Docker host-side port mappings (containers use default ports internally) ---
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
